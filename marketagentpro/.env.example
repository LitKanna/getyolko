# MarketAgentPro data provider settings
# Current options: yfinance, alpaca
# yfinance = candles and latest price from yfinance
# alpaca = historical candles still use yfinance; latest quote uses Alpaca with yfinance fallback
MARKET_DATA_PROVIDER=yfinance

# Alpaca Market Data API
# Keep real keys in .env only. Do not commit .env to GitHub.
# Demo users can also enter their own keys in the app sidebar under
# "Alpaca / Market Data" (saved to data/marketagentpro_settings.json).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# For a free/basic setup, start with iex.
# If your Alpaca plan supports SIP, you can try sip later.
ALPACA_DATA_FEED=iex
ALPACA_USE_QUOTE_MID_WHEN_NEWER=true
ALPACA_QUOTE_NEWER_THAN_TRADE_SECONDS=30
ALPACA_MAX_QUOTE_SPREAD_PCT=2.0

# Dashboard-only extended-hours price fallback.
# If Today/2 Days chart has a newer yfinance pre/after-hours candle than Alpaca last trade,
# Dashboard can show the chart close so Current Price follows the visible chart.
DASHBOARD_USE_CHART_CLOSE_EXTENDED_HOURS_FALLBACK=true
DASHBOARD_CHART_CLOSE_NEWER_THAN_QUOTE_SECONDS=120
DASHBOARD_CHART_CLOSE_MIN_DIFF_PCT=0.05

# Options data feed: indicative works for free/basic testing; opra requires paid OPRA access.
ALPACA_OPTIONS_FEED=indicative

# Optional refresh tuning
LATEST_QUOTE_CACHE_SECONDS=5
OPTION_SNAPSHOT_CACHE_SECONDS=30
OPTION_BARS_CACHE_SECONDS=300
TODAY_PAGE_REFRESH_SECONDS=5

# Default options strategy profit target percentage.
DEFAULT_OPTIONS_PROFIT_TARGET_PCT=60

# Ollama / local AI defaults. Sidebar AI Settings can override and save these.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_NUM_CTX=16384
OLLAMA_TEMPERATURE=0.3

# Dashboard market status / stale price notes are currently fixed in code:
# Regular market stale threshold: ~120s
# Extended-hours stale threshold: ~300s

# AI Provider Layer v3 / publish-ready BYOK foundation.
# - If a .env file exists, its values are the defaults: use ollama (local) by default.
# - Without a .env, users can enter their own OpenAI (GPT) or Anthropic (Claude)
#   API keys directly in the sidebar AI Settings panel (saved to
#   data/marketagentpro_settings.json, never uploaded).
# off = no LLM calls; app still shows English source news and rule-based summaries.
# ollama = local Ollama for translation and AI analysis (default).
# openai = OpenAI GPT via your own API key.
# anthropic = Anthropic Claude via your own API key.
AI_PROVIDER=ollama
AI_LANGUAGE_MODE=english_only

# OpenAI (GPT) BYOK defaults. Leave the key empty to enter it in the app UI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude) BYOK defaults.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Dashboard AI capability settings.
# fast = best for small/slow local models; balanced = recommended for qwen2.5:14b; detailed = stronger/cloud models later.
DASHBOARD_AI_MODE=balanced
# auto = stream when the provider supports it; on/off can override.
AI_STREAMING=auto
# How many recent stock-news items Dashboard AI receives: 3, 5, or 8.
DASHBOARD_AI_MAX_NEWS_ITEMS=5
# short / medium / long controls generated analyst brief length.
DASHBOARD_AI_OUTPUT_LENGTH=medium
